# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_URL=http://localhost:3000
PORT=4000
# tidecloak = verify real tokens; mock = Bearer mock:<sub>:<role,role> (fallback if login is not working)
AUTH_MODE=mock

# --- TideCloak (local Docker) ---
TIDECLOAK_URL=http://localhost:8080
TIDECLOAK_REALM=safedesk
TIDECLOAK_CLIENT_ID=safedesk-web
TIDECLOAK_AUDIENCE=
# Agent service identity (client_credentials)
AGENT_CLIENT_ID=
AGENT_CLIENT_SECRET=
# Contrast demo only: lets x-demo-admin-agent header give the agent admin power. Never in production.
UNSAFE_DEMO=false
# Master admin password for the local TideCloak server. Choose your own.
TIDECLOAK_ADMIN_PASSWORD=

# Tide licence (required by the Tide bootstrap)
TIDE_LICENSE_EMAIL=
TIDE_TERMS_ACCEPTED=

# --- Agent ---
# Leave empty to use the rule-based fallback.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-5-5

# --- Policy ---
# Refunds above this (VND) become pending requests needing 2-of-3 approval.
REFUND_LIMIT_VND=500000
APPROVALS_REQUIRED=2
APPROVER_COUNT=3

# --- Storage ---
DATA_FILE=./data/state.json

# Comma-separated TideCloak user ids (sub) of the two demo customers; leave empty in mock mode.
SEED_CUSTOMER_SUBS=
