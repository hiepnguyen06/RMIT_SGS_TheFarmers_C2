# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_URL=http://localhost:3000
PORT=4000
# tidecloak = verify real tokens; mock = Bearer mock:<sub>:<role,role> (fallback if login is not working)
AUTH_MODE=mock

# --- TideCloak (local Docker) ---
TIDECLOAK_URL=http://localhost:8080
TIDECLOAK_REALM=safedesk
TIDECLOAK_CLIENT_ID=safedesk-web
TIDECLOAK_AUDIENCE=safedesk-web   # required when AUTH_MODE=tidecloak
# Adapter JSON from the realm bootstrap; its embedded key verifies tokens (path relative to server/)
TIDECLOAK_ADAPTER_FILE=../data/tidecloak.json
# Only behind a reverse proxy you control: rebuild the DPoP URL from x-forwarded-host/-proto
TRUST_FORWARDED_HEADERS=false
# Agent identity: simulated = the API gives the agent the narrow support-agent role itself;
# client_credentials = the agent signs in as a TideCloak service client (needs AGENT_CLIENT_ID/SECRET below,
# which the safedesk realm does not have yet).
AGENT_IDENTITY=simulated
# Agent service identity (client_credentials)
AGENT_CLIENT_ID=
AGENT_CLIENT_SECRET=
# Contrast demo only: lets x-demo-admin-agent header give the agent admin power. Never in production.
UNSAFE_DEMO=false
# Master admin password for the local TideCloak server. Choose your own.
TIDECLOAK_ADMIN_PASSWORD=

# Tide licence (required by the Tide bootstrap)
TIDE_LICENSE_EMAIL=
TIDE_TERMS_ACCEPTED=

# --- Agent ---
# Leave empty to use the rule-based fallback.
OPENAI_API_KEY=
AGENT_MODEL=gpt-4o-mini

# --- Policy ---
# Refunds above this (VND) become pending requests needing an admin's approval.
REFUND_LIMIT_VND=500000
# Admins are the approvers. With one admin account both are 1; raise them together if you add admins.
APPROVALS_REQUIRED=1
APPROVER_COUNT=1

# --- Public customer ---
# Chat needs no sign-in; every chat acts as this fixed customer.
PUBLIC_CUSTOMER_SUB=cust-an
PUBLIC_CUSTOMER_NAME=An Nguyen
# Chat messages per client address per 10 minutes (the chat endpoint is public).
CHAT_RATE_LIMIT=30

# --- Storage ---
DATA_FILE=./data/state.json
